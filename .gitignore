# ============================================================
# Django backend: backend/
# ============================================================

# Python bytecode and caches
/karaoke-gen-service/**/__pycache__/
/karaoke-gen-service/**/*.py[cod]
/karaoke-gen-service/**/.pytest_cache/
/karaoke-gen-service/**/.mypy_cache/
/karaoke-gen-service/**/.ruff_cache/

# Python virtual environments
/karaoke-gen-service/.venv/
/karaoke-gen-service/venv/
/karaoke-gen-service/env/

# Django/local application configuration and secrets
/karaoke-gen-service/.env
/karaoke-gen-service/.env.*
!/karaoke-gen-service/.env.example
/karaoke-gen-service/**/local_settings.py

# Local SQLite database files
/karaoke-gen-service/db.sqlite3
/karaoke-gen-service/db.sqlite3-journal
/karaoke-gen-service/*.sqlite3

# Application logs
/karaoke-gen-service/*.log
/karaoke-gen-service/logs/

# Test/coverage output
/karaoke-gen-service/.coverage
/karaoke-gen-service/.coverage.*
/karaoke-gen-service/htmlcov/
/karaoke-gen-service/coverage.xml

# Generated Django deployment assets
/karaoke-gen-service/staticfiles/

# User uploads — ignore only if stored locally
/karaoke-gen-service/media/

