# Karaoke service settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Downstream processing service
LYRICS_ALIGN_SERVICE_URL=http://localhost:8001
LYRICS_ALIGN_REQUEST_TIMEOUT_SECONDS=60
LYRICS_ALIGN_JOB_TIMEOUT_SECONDS=3600
LYRICS_ALIGN_POLL_INTERVAL_SECONDS=2

# Local media. Set these to persistent paths/URLs in production.
MEDIA_ROOT=media
MEDIA_URL=/media/

JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=30
