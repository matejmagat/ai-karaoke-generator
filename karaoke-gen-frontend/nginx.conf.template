upstream karaoke_api {
    server ${API_UPSTREAM};
}

server {
    listen 80;
    server_name _;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/x-subrip;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Django API, admin, and API docs.
    location ~ ^/(api|admin)/ {
        proxy_pass http://karaoke_api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Uploads are streamed to Django, which forwards them to the aligner.
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Django collectstatic output (admin/Swagger assets), shared via a volume.
    # Served under /django-static/ because CRA already owns /static/.
    location /django-static/ {
        alias /srv/django-static/;
        expires 7d;
        access_log off;
    }

    # Generated stems and SRT lyrics, shared via a volume.
    location /media/ {
        alias /srv/media/;
        types {
            audio/wav wav;
            audio/mpeg mp3;
            audio/flac flac;
            audio/ogg ogg;
            audio/mp4 m4a;
            application/x-subrip srt;
        }
        default_type application/octet-stream;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Content-hashed CRA bundles.
    location /static/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
