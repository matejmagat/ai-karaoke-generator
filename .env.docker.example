# Copy to .env in the repository root before running `docker compose up`.

# Host port for the web app (nginx serves the React app and proxies the API).
APP_PORT=8080

# Required: Genius API token used to normalise transcribed lyrics.
GENIUS_ACCESS_TOKEN=

# Required: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,karaoke-gen-service
# Must include the public origin(s) the browser uses, e.g. http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to True when a TLS-terminating proxy in front of nginx sends X-Forwarded-Proto.
DJANGO_SECURE_PROXY_SSL_HEADER=False

POSTGRES_DB=karaoke
POSTGRES_USER=karaoke
POSTGRES_PASSWORD=change-me

# cpu (default) or cu128. compose.gpu.yaml sets cu128 automatically.
TORCH_VARIANT=cpu

# Empty = the frontend calls the API on its own origin through nginx.
REACT_APP_API_BASE_URL=

LYRICS_ALIGN_REQUEST_TIMEOUT_SECONDS=120
LYRICS_ALIGN_JOB_TIMEOUT_SECONDS=3600
LYRICS_ALIGN_POLL_INTERVAL_SECONDS=2
NGINX_CLIENT_MAX_BODY_SIZE=200m
